rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return isSignedIn() ? request.auth.token.role : null;
    }
    function isSatgasOrAbove() {
      return role() in ['satgas', 'kepsek', 'pusat'];
    }
    function isPusat() {
      return role() == 'pusat';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ============ USERS (profil) ============
    // Siswa/guru hanya bisa baca profil sendiri
    match /students/{docId} {
      allow read: if isSatgasOrAbove() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isSatgasOrAbove() && role() != 'satgas' ? true : false;
      // Hanya kepsek/pusat yang boleh create/update/delete
      allow create, update, delete: if role() in ['kepsek', 'pusat'];
    }
    match /staff/{docId} {
      allow read: if isSatgasOrAbove() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if role() in ['kepsek', 'pusat'];
    }

    // ============ CASES (kasus) ============
    match /cases/{caseId} {
      // Siapa pun yang login boleh membuat laporan
      allow create: if isSignedIn();

      // Baca:
      // - Pelapor boleh baca laporan sendiri
      // - Satgas SR ke atas boleh baca semua
      allow read: if isSatgasOrAbove()
                  || (isSignedIn() && resource.data.reporterUid == request.auth.uid)
                  || (isSignedIn() && resource.data.victimUid == request.auth.uid);

      // Update:
      // - Satgas ke atas boleh update apa pun
      // - Pelapor hanya boleh update laporan sendiri selama status "Baru"
      allow update: if isSatgasOrAbove()
                    || (isSignedIn()
                        && resource.data.reporterUid == request.auth.uid
                        && resource.data.status == 'Baru');

      // Delete: hanya pusat
      allow delete: if isPusat();

      // ============ SUBCOLLECTIONS ============
      match /assessments/{aId} {
        allow read: if isSatgasOrAbove();
        allow write: if isSatgasOrAbove();
      }
      match /interventions/{iId} {
        allow read: if isSatgasOrAbove()
                    || (isSignedIn() && get(/databases/$(database)/documents/cases/$(caseId)).data.victimUid == request.auth.uid);
        allow write: if isSatgasOrAbove();
      }
      match /timeline/{tId} {
        allow read: if isSatgasOrAbove()
                    || (isSignedIn() && get(/databases/$(database)/documents/cases/$(caseId)).data.reporterUid == request.auth.uid);
        allow write: if isSatgasOrAbove();
      }
    }

    // Default: tolak semua
    match /{document=**} {
      allow read, write: if false;
    }
  }
}